// Meshlet frustum and back-face culling with indirect draw compaction.
//
// One invocation per meshlet. Visible meshlets claim a slot in a compacted list and write their own
// draw command into it, so the output buffer ends up dense and vkCmdDrawIndexedIndirectCount can
// consume it without the CPU ever reading back a count.
//
// The compaction is wave-cooperative: one ballot per wave, one atomic per wave. A per-lane atomic
// aims every surviving lane in the dispatch at the same address, and that counter is the single
// most contended location in the pass. RE Engine measured cluster culling at 0.543 ms with one
// cluster per wave and 0.051 ms once a wave appended cooperatively -- better than ten times, for a
// change that does no less work.
//
// local_size_x is 64: two full wave32s on RDNA, one full wave64 on GCN. AMD's guidance is a
// multiple of 64 so that no lane is masked out on either generation. The subgroup intrinsics below
// adapt to whichever width the driver actually reports, so the same source is correct on both.

#version 450

// One ballot, reused for both the exclusive prefix and the total. Asking for
// subgroupExclusiveAdd and subgroupAdd separately is the same predicate twice, and some compilers
// emit a second ballot for it rather than caching the mask.
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_ballot : require

layout(local_size_x = 64) in;

layout(std140, binding = 0) uniform Frame {
    mat4  viewProjection;
    vec4  frustumPlanes[6];   // xyz normal, w distance; inside is n . p + d >= 0
    vec4  cameraOrigin;       // subtracted from section origins to keep the maths in float range
    uint  meshletCount;
    uint  hizWidth;
    uint  hizHeight;
    uint  _pad0;
};

// x = packed bounds (six 5-bit fields, section-local), yzw = the section's origin in blocks as
// float bits. Float bits rather than the raw uint: a section origin is negative for any
// section west or north of the world origin, and converting a two's-complement negative
// through uint-to-float reads it as roughly four billion. A section origin is a multiple of
// 16, so it is exactly representable and nothing is lost.
layout(std430, binding = 1) readonly buffer MeshletData {
    uvec4 meshlets[];
};

// VkDrawIndexedIndirectCommand: indexCount, instanceCount, firstIndex, vertexOffset, firstInstance.
layout(std430, binding = 2) buffer DrawCommands {
    uint draws[];
};

layout(std430, binding = 3) buffer Counters {
    uint visibleCount;
    uint testedCount;
};

// One uint per meshlet: the orientation bucket in the low three bits, the quad count above them.
// Six orientations need three bits and the packed bounds word has two free, so this is its own
// buffer; the quad count rides along because the draw command below needs it and there is nowhere
// else per-meshlet to put it.
layout(std430, binding = 4) readonly buffer MeshletSideData {
    uint sideData[];
};

layout(push_constant) uniform Push {
    uint baseMeshlet;
    uint flags;
};

// Mirrors net.amdfaster.cull.Frustum.intersectsAabb: test the box corner furthest along each
// plane normal, and only if that corner is outside is the whole box outside.
bool visibleAgainstFrustum(vec3 boxMin, vec3 boxMax) {
    for (int p = 0; p < 6; ++p) {
        vec4 plane = frustumPlanes[p];
        vec3 corner = mix(boxMax, boxMin, lessThan(plane.xyz, vec3(0.0)));
        if (dot(plane.xyz, corner) + plane.w < 0.0) {
            return false;
        }
    }
    return true;
}

vec3 decodeTriple(uint packed, uint shift) {
    return vec3(float((packed >> shift) & 0x1Fu),
                float((packed >> (shift + 5u)) & 0x1Fu),
                float((packed >> (shift + 10u)) & 0x1Fu));
}

void main() {
    if ((flags & 2u) != 0u && gl_LocalInvocationIndex == 0u) {
        visibleCount = 0u;
        testedCount = 0u;
    }
    // The reset above is in the same dispatch as the first reads, so it needs a barrier before
    // any invocation is allowed to count.
    barrier();

    uint index = baseMeshlet + gl_GlobalInvocationID.x;
    bool inRange = index < meshletCount;

    // No early return past this point. Subgroup operations only see active lanes, so a lane that
    // returned would silently drop out of the ballot and the wave's totals would be short.
    bool visible = false;
    if (inRange) {
        uvec4 record = meshlets[index];
        uint packed = record.x;
        vec3 origin = uintBitsToFloat(record.yzw) - cameraOrigin.xyz;

        vec3 boxMin = origin + decodeTriple(packed, 0u);
        vec3 boxMax = origin + decodeTriple(packed, 15u);

        visible = visibleAgainstFrustum(boxMin, boxMax);

        // Whole-meshlet back-face cull. Every face in a meshlet shares the bucket's normal, so one
        // comparison replaces a per-face test, and what it saves is the vertex shading and the draw
        // rather than the fragments -- the rasteriser was already rejecting these.
        //
        // Gated on bit 30 of the packed bounds: a meshlet whose builder never declared itself
        // single-sided is left alone. boxMin and boxMax are camera-relative here, so the camera is
        // at the origin and each test is a comparison against zero.
        if (visible && (packed >> 30u & 1u) != 0u) {
            uint o = sideData[index] & 7u;
            // Ordinals: NEG_X 0, POS_X 1, NEG_Y 2, POS_Y 3, NEG_Z 4, POS_Z 5.
            bool positive = (o & 1u) != 0u;
            bool backFacing;
            if (o < 2u) {
                backFacing = positive ? boxMin.x >= 0.0 : boxMax.x <= 0.0;
            } else if (o < 4u) {
                backFacing = positive ? boxMin.y >= 0.0 : boxMax.y <= 0.0;
            } else {
                backFacing = positive ? boxMin.z >= 0.0 : boxMax.z <= 0.0;
            }
            visible = !backFacing;
        }
    }

    // One ballot each, reused for the prefix and the total.
    uvec4 testedMask = subgroupBallot(inRange);
    uint waveTested = subgroupBallotBitCount(testedMask);

    uvec4 visibleMask = subgroupBallot(visible);
    uint laneSlot = subgroupBallotExclusiveBitCount(visibleMask);
    uint waveVisible = subgroupBallotBitCount(visibleMask);

    // subgroupElect is the lowest *active* lane, which is what makes this correct across an early
    // bail-out above: the lanes that had no meshlet are not active and do not get counted.
    uint visibleBase = 0u;
    if (subgroupElect()) {
        if (waveTested != 0u) {
            atomicAdd(testedCount, waveTested);
        }
        // Skipping the atomic entirely when the wave contributed nothing is the other half of the
        // saving: on a dispatch padded out to a work-group boundary, most of the tail waves have
        // nothing to append.
        if (waveVisible != 0u) {
            visibleBase = atomicAdd(visibleCount, waveVisible);
        }
    }
    visibleBase = subgroupBroadcastFirst(visibleBase);

    if (visible) {
        // indexCount, instanceCount, firstIndex, vertexOffset, firstInstance.
        //
        // Every meshlet reserves a fixed 372-index / 248-vertex stride, so where its run starts is
        // derivable from the meshlet index alone with no lookup table. How much of that stride to
        // draw is not: a meshlet with fewer than 62 quads leaves the rest unread, and drawing the
        // whole reserved stride would shade the padding. The tail is zero-filled, so those come out
        // as degenerate triangles and nothing looks wrong -- which is why the exact count comes
        // from the side data word rather than being assumed.
        uint base = (visibleBase + laneSlot) * 5u;
        draws[base + 0u] = (sideData[index] >> 3u) * 6u;   // indexCount = quads * 6
        draws[base + 1u] = 1u;                             // instanceCount
        draws[base + 2u] = index * 372u;
        draws[base + 3u] = index * 248u;
        draws[base + 4u] = 0u;
    }
}
