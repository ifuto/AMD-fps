// Meshlet frustum and back-face culling with indirect draw compaction.
//
// One invocation per meshlet. Visible meshlets claim a slot with an atomic add and write their own
// draw command into it, so the output buffer ends up dense and vkCmdDrawIndexedIndirectCount can
// consume it without the CPU ever reading back a count.
//
// local_size_x is 64: two full wave32s on RDNA, one full wave64 on GCN. AMD's guidance is a
// multiple of 64 so that no lane is masked out on either generation.

#version 450

layout(local_size_x = 64) in;

layout(std140, binding = 0) uniform Frame {
    mat4  viewProjection;
    vec4  frustumPlanes[6];   // xyz normal, w distance; inside is n . p + d >= 0
    vec4  cameraOrigin;       // subtracted from section origins to keep the maths in float range
    uint  meshletCount;
    uint  hizWidth;
    uint  hizHeight;
    uint  _pad0;
};

// x = packed bounds (six 5-bit fields, section-local), yzw = the section's origin in blocks.
layout(std430, binding = 1) readonly buffer MeshletData {
    uvec4 meshlets[];
};

// VkDrawIndexedIndirectCommand: indexCount, instanceCount, firstIndex, vertexOffset, firstInstance.
layout(std430, binding = 2) buffer DrawCommands {
    uint draws[];
};

layout(std430, binding = 3) buffer Counters {
    uint visibleCount;
    uint testedCount;
};

// One uint per meshlet: its Orientation.ordinal(), 0..5. Six orientations need three bits and the
// packed bounds word has two free, so this is its own buffer.
layout(std430, binding = 5) readonly buffer MeshletOrientations {
    uint orientations[];
};

layout(push_constant) uniform Push {
    uint baseMeshlet;
    uint flags;
};

// Mirrors net.amdfaster.cull.Frustum.intersectsAabb: test the box corner furthest along each
// plane normal, and only if that corner is outside is the whole box outside.
bool visibleAgainstFrustum(vec3 boxMin, vec3 boxMax) {
    for (int p = 0; p < 6; ++p) {
        vec4 plane = frustumPlanes[p];
        vec3 corner = mix(boxMax, boxMin, lessThan(plane.xyz, vec3(0.0)));
        if (dot(plane.xyz, corner) + plane.w < 0.0) {
            return false;
        }
    }
    return true;
}

vec3 decodeTriple(uint packed, uint shift) {
    return vec3(float((packed >> shift) & 0x1Fu),
                float((packed >> (shift + 5u)) & 0x1Fu),
                float((packed >> (shift + 10u)) & 0x1Fu));
}

void main() {
    if ((flags & 2u) != 0u && gl_LocalInvocationIndex == 0u) {
        visibleCount = 0u;
        testedCount = 0u;
    }
    // The reset above is in the same dispatch as the first reads, so it needs a barrier before
    // any invocation is allowed to count.
    barrier();

    uint index = baseMeshlet + gl_GlobalInvocationID.x;
    if (index >= meshletCount) {
        return;
    }

    uvec4 record = meshlets[index];
    uint packed = record.x;
    vec3 origin = vec3(record.yzw) - cameraOrigin.xyz;

    vec3 boxMin = origin + decodeTriple(packed, 0u);
    vec3 boxMax = origin + decodeTriple(packed, 15u);

    atomicAdd(testedCount, 1u);
    if (!visibleAgainstFrustum(boxMin, boxMax)) {
        return;
    }

    // Whole-meshlet back-face cull. Every face in a meshlet shares the bucket's normal, so one
    // comparison replaces a per-face test, and what it saves is the vertex shading and the draw
    // rather than the fragments -- the rasteriser was already rejecting these.
    //
    // Gated on bit 30 of the packed bounds: a meshlet whose builder never declared itself
    // single-sided is left alone. boxMin and boxMax are camera-relative here, so the camera is at
    // the origin and each test is a comparison against zero.
    if ((packed >> 30u & 1u) != 0u) {
        uint o = orientations[index];
        // Ordinals: NEG_X 0, POS_X 1, NEG_Y 2, POS_Y 3, NEG_Z 4, POS_Z 5.
        bool positive = (o & 1u) != 0u;
        bool backFacing;
        if (o < 2u) {
            backFacing = positive ? boxMin.x >= 0.0 : boxMax.x <= 0.0;
        } else if (o < 4u) {
            backFacing = positive ? boxMin.y >= 0.0 : boxMax.y <= 0.0;
        } else {
            backFacing = positive ? boxMin.z >= 0.0 : boxMax.z <= 0.0;
        }
        if (backFacing) {
            return;
        }
    }

    // indexCount, instanceCount, firstIndex, vertexOffset, firstInstance.
    // One meshlet is at most 62 quads = 372 indices and 248 vertices, all inside its own
    // contiguous run, so the command is derivable from the meshlet index alone.
    uint slot = atomicAdd(visibleCount, 1u);
    uint base = slot * 5u;
    draws[base + 0u] = 372u;      // indexCount
    draws[base + 1u] = 1u;        // instanceCount
    draws[base + 2u] = index * 372u;
    draws[base + 3u] = index * 248u;
    draws[base + 4u] = 0u;
}
