// Second pass of the two-pass occlusion cull: retest the meshlets the first pass kept against the
// previous frame's hierarchical depth buffer.
//
// The first pass redraws everything visible last frame and builds the Hi-Z pyramid on the way.
// This pass then rejects whatever is behind it, which is the large majority of a typical scene.
// Doing it in two passes is what keeps the first pass cheap: it only ever draws what was visible
// before, so its cost tracks the visible set rather than the whole world.
//
// Depth is reversed-Z, so "closer" is a larger value. A meshlet is occluded when its nearest depth
// is behind *every* surface its footprint covers, which is a statement about the MINIMUM depth over
// that footprint. The pyramid must therefore be built by min-reduction -- hiz_reduce.comp does
// exactly that -- and the comparison below reads a minimum, not a maximum.
//
// A max-reduced pyramid answers a different question: "is this box behind the nearest thing anywhere
// in the region". One near pixel in the region is then enough to satisfy it, and boxes that are
// plainly visible through the rest of their footprint get deleted. That is not a missed cull, it is
// geometry disappearing, which is why the direction matters more than the shape of the pyramid.

#version 450

layout(local_size_x = 64) in;

layout(std140, binding = 0) uniform Frame {
    mat4  viewProjection;
    vec4  frustumPlanes[6];
    vec4  cameraOrigin;
    uint  meshletCount;
    uint  hizWidth;
    uint  hizHeight;
    uint  _pad0;
};

layout(std430, binding = 1) readonly buffer MeshletData {
    uvec4 meshlets[];
};

layout(std430, binding = 2) buffer DrawCommands {
    uint draws[];
};

layout(std430, binding = 3) buffer Counters {
    uint visibleCount;    // in: count from the frustum pass, out: count after occlusion
    uint testedCount;
};

// A combined image sampler rather than a bare texture2D: textureSize and texelFetch on a
// samplerless texture need GL_EXT_samplerless_texture_functions in GLSL 4.50, and the sampler
// expresses what the fetch actually wants anyway -- nearest filtering, so no texel is averaged
// across the reduction, and clamp-to-edge so a box hanging off the screen edge still reads.
layout(binding = 5) uniform sampler2D hiZDepth;

layout(push_constant) uniform Push {
    uint baseMeshlet;
    uint flags;
};

// The coarsest level whose texels are at least as large as the box. Sampling anything finer means
// a gather over pixels the pyramid has already reduced, which is both slower and no more correct.
//
// The chain is ceil-halved, matching PyramidGeometry on the CPU. Vulkan's own mip rule floors, and
// on 1920x1080 that leaves level 4 sixty-seven rows tall where 67 * 2 = 134 -- row 135 of level 3
// would belong to no texel above it. Under a min-reduction a dropped texel makes the stored value
// LARGER, which culls visible geometry rather than merely missing a cull.
int ceilDim(int base, int level) {
    return max(1, -(-base >> level));
}

int selectLevel(vec2 boxPixels) {
    float longest = max(boxPixels.x, boxPixels.y);
    if (longest <= 1.0) {
        return 0;
    }
    int maxLevel = 0;
    while (ceilDim(int(hizWidth), maxLevel) > 1 || ceilDim(int(hizHeight), maxLevel) > 1) {
        ++maxLevel;
    }
    // The same integer path PyramidGeometry takes on the CPU: ceiling, then a bit count. findMSB(v)
    // + 1 is the number of bits v needs, so this is the smallest level whose texel is at least
    // ceil(longest) pixels. Doing it in integers rather than with log2 is what makes the two agree
    // exactly -- the CPU mirror is what the tests pin, and a level of disagreement between them
    // would mean objects appearing and disappearing depending on which path answered.
    int n = longest >= 2147483648.0 ? 2147483647 : int(ceil(longest));
    return min(findMSB(n - 1) + 1, maxLevel);
}

// Projects the eight corners and takes the hull. Not the tightest bound, but cheap and
// conservative. Returns false when any corner lands behind the camera, in which case the caller
// must treat the meshlet as visible: culling on a degenerate projection is how geometry
// disappears while the player is looking straight at it.
bool projectToPixels(vec3 boxMin, vec3 boxMax, out vec4 pixels) {
    vec2 lo = vec2(1e30);
    vec2 hi = vec2(-1e30);
    for (int corner = 0; corner < 8; ++corner) {
        vec3 p = mix(boxMin, boxMax, notEqual(bvec3(corner & 1, corner & 2, corner & 4), bvec3(false)));
        vec4 clip = viewProjection * vec4(p, 1.0);
        if (clip.w <= 0.0) {
            return false;
        }
        vec2 ndc = clip.xy / clip.w;
        // Vulkan's framebuffer has Y growing downwards; NDC has it growing upwards.
        vec2 pixel = vec2((ndc.x * 0.5 + 0.5) * float(hizWidth),
                          (0.5 - ndc.y * 0.5) * float(hizHeight));
        lo = min(lo, pixel);
        hi = max(hi, pixel);
    }
    pixels = vec4(lo, hi);
    return true;
}

void main() {
    // This pass walks the *compacted* array the frustum pass produced, not the meshlet list: the
    // draw command at slot s carries its meshlet index in firstIndex, which is what recovers the
    // bounds. Walking the original list here would test meshlets that are already gone.
    uint slot = baseMeshlet + gl_GlobalInvocationID.x;
    if (slot >= visibleCount) {
        return;
    }

    uint base = slot * 5u;
    uint index = draws[base + 2u] / 372u;
    uvec4 record = meshlets[index];
    vec3 origin = vec3(record.yzw) - cameraOrigin.xyz;
    vec3 boxMin = origin + vec3(float(record.x & 0x1Fu),
                                float((record.x >> 5u) & 0x1Fu),
                                float((record.x >> 10u) & 0x1Fu));
    vec3 boxMax = origin + vec3(float((record.x >> 15u) & 0x1Fu),
                                float((record.x >> 20u) & 0x1Fu),
                                float((record.x >> 25u) & 0x1Fu));

    vec4 pixels;
    if (!projectToPixels(boxMin, boxMax, pixels)) {
        return;   // keep it
    }
    if (pixels.z <= 0.0 || pixels.x >= float(hizWidth)
            || pixels.w <= 0.0 || pixels.y >= float(hizHeight)) {
        return;   // fully off screen; the frustum pass should have caught this, but be safe
    }

    int level = selectLevel(pixels.zw - pixels.xy);

    // Every texel the box overhangs, not the one at its centre. Reading a single texel tests the box
    // against a footprint that is not its own. At the selected level a box spans at most two texels
    // per axis, so this is at most four fetches.
    ivec2 spanLimit = ivec2(ceilDim(int(hizWidth), level), ceilDim(int(hizHeight), level)) - ivec2(1);
    ivec2 lo = clamp(ivec2(floor(pixels.xy)) >> level, ivec2(0), spanLimit);
    ivec2 hi = clamp(ivec2(floor(pixels.zw)) >> level, ivec2(0), spanLimit);

    float pyramidMin = 1e30;
    for (int ty = lo.y; ty <= hi.y; ++ty) {
        for (int tx = lo.x; tx <= hi.x; ++tx) {
            pyramidMin = min(pyramidMin, texelFetch(hiZDepth, ivec2(tx, ty), level).r);
        }
    }

    // Nearest depth of the box in reversed-Z is its largest clip z over clip w.
    float nearest = 0.0;
    for (int corner = 0; corner < 8; ++corner) {
        vec3 p = mix(boxMin, boxMax,
                     notEqual(bvec3(corner & 1, corner & 2, corner & 4), bvec3(false)));
        vec4 clip = viewProjection * vec4(p, 1.0);
        nearest = max(nearest, clip.z / clip.w);
    }

    if (nearest < pyramidMin) {
        // The box's closest point is behind every surface its footprint covers: fully occluded.
        // Zeroing the instance count drops the draw without a second compaction pass.
        draws[base + 1u] = 0u;
        atomicAdd(testedCount, 1u);
    }
}
