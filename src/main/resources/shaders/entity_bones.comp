#version 430 core

// Bone matrix evaluation on the GPU, replacing the CPU path in
// net.amdfaster.entity.BonePalette.
//
// Why this exists: evaluating bones on the CPU gets the matrix count down from once per vertex to
// once per entity, which is a 120-fold reduction, but it costs 1.5 KB of upload per entity per frame.
// Doing it here keeps the reduction and drops the upload.
//
// The hard part is the dependency: bone b's world matrix needs its parent's. One invocation per bone
// would need the parents finished first, and a compute shader has no way to order invocations within
// a dispatch. The two obvious fixes are both worse than what is done here -- a workgroup per entity
// serialises the bones onto one thread, and a barrier per hierarchy level needs the level structure
// uploaded alongside the rig.
//
// Instead each invocation walks from its own bone up to the root and accumulates on the way down.
// That is fully parallel with no synchronisation at all, and it costs depth matrix multiplications
// instead of one. Vanilla entity models are three or four levels deep, so this does roughly four
// times the arithmetic of a serial pass to avoid serialising, which is the right trade on a GPU with
// thousands of idle lanes and a hierarchy that shallow.

layout(local_size_x = 64) in;   // one invocation per (instance, bone), matching the workgroup size
                                // the rest of this mod's compute uses

// Per-instance animation scalars. The trigonometry has already been done once per entity on the CPU
// by EntityAnimation; what arrives here is an angle per bone, not a pose to interpret. Keeping the
// evaluation as a pure function of rig and angle is what lets this shader and BonePalette be
// interchangeable.
layout(binding = 0, std430) readonly buffer RigData {
    // One entry per bone: x = parent index or -1, y = axis or -1, z = angle in radians, w = unused.
    vec4 rig[];
};

layout(binding = 1, std430) readonly buffer PivotData {
    vec4 pivots[];   // xyz = pivot offset from parent, w = unused
};

layout(binding = 2, std430) readonly buffer InstanceRange {
    ivec2 range;     // x = first instance, y = instance count
};

layout(binding = 3, std430) writeonly buffer BoneData {
    mat4 bones[];
};

const int MAX_BONES = 24;   // has to match BonePalette.MAX_BONES

// Builds the local matrix for one bone: translate to the pivot, then rotate about it.
mat4 localMatrix(int bone) {
    vec4 pivot = pivots[bone % MAX_BONES];
    vec4 r = rig[bone % MAX_BONES];
    int axis = int(r.y);
    float a = r.z;

    mat4 m = mat4(1.0);
    m[3] = vec4(pivot.xyz, 1.0);

    if (axis < 0) {
        return m;
    }
    float c = cos(a);
    float s = sin(a);
    mat4 rot = mat4(1.0);
    if (axis == 0) {
        rot[1] = vec4(0.0, c, s, 0.0);
        rot[2] = vec4(0.0, -s, c, 0.0);
    } else if (axis == 1) {
        rot[0] = vec4(c, 0.0, -s, 0.0);
        rot[2] = vec4(s, 0.0, c, 0.0);
    } else {
        rot[0] = vec4(c, s, 0.0, 0.0);
        rot[1] = vec4(-s, c, 0.0, 0.0);
    }
    // Translate then rotate, so the bone pivots at its own offset and that offset is not itself
    // rotated. The same convention BonePalette uses and its tests pin.
    return m * rot;
}

void main() {
    int linear = int(gl_GlobalInvocationID.x);
    int instance = range.x + linear / MAX_BONES;
    int bone = linear % MAX_BONES;

    if (instance >= range.x + range.y) {
        return;
    }

    // Walk up to the root collecting the chain, then multiply back down. The chain is short and
    // MAX_BONES bounds it, so the loop cannot run away on a malformed rig.
    int chain[MAX_BONES];
    int depth = 0;
    int cursor = bone;
    while (cursor >= 0 && depth < MAX_BONES) {
        chain[depth++] = cursor;
        cursor = int(rig[cursor % MAX_BONES].x);
    }

    mat4 world = mat4(1.0);
    for (int i = depth - 1; i >= 0; i--) {
        world = world * localMatrix(chain[i]);
    }

    bones[instance * MAX_BONES + bone] = world;
}
